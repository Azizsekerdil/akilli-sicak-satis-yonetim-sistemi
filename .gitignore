# ---------------------------------------------------------------------------
# Uyumluluk kanıtları / Compliance evidence
# ---------------------------------------------------------------------------
# Gerçek tarama çıktıları veritabanı yollarını ve alan adlarını içerir; bunlar
# kurulumun kendi verisidir, kaynağın parçası değildir.
# Real scan output describes the installation's own data, not the source.
compliance/evidence/*.json

# ---------------------------------------------------------------------------
# Sunum ara çıktıları / Presentation intermediates
# ---------------------------------------------------------------------------
# Üretilen deste (docs/presentation/*.pdf|pptx|html) ve kaynak ekran
# görüntüleri (docs/presentation/ekranlar/) BİLEREK depoda tutulur: zincirin
# çıktısı, zincirin kendisiyle birlikte incelenebilir olmalıdır.
# Yalnızca geçici üretim artıkları yok sayılır.
docs/presentation/*.tmp
docs/presentation/~$*
