# ===========================================================================
#  Akıllı Sıcak Satış Yönetim Sistemi — Environment Template
#  Smart Van Sales Management System — Environment Template
# ---------------------------------------------------------------------------
#  Copy this file to `.env` and fill in your own values.
#  `.env` is git-ignored and MUST NEVER be committed.
#
#  NO REAL CREDENTIAL APPEARS IN THIS FILE, and none ever should.
#  Every secret below is either empty or the literal placeholder
#  YOUR_PROVIDER_API_KEY_HERE.  Leave a key empty and the corresponding
#  provider reports NOT_CONFIGURED and makes no network call — local AI and
#  every non-AI feature keep working.
# ===========================================================================

# --- Application ----------------------------------------------------------
VS_APP_NAME="Akilli Sicak Satis Yonetim Sistemi"
VS_ENV=development                 # development | production | test
VS_DEBUG=true
VS_HOST=127.0.0.1
VS_PORT=8000
VS_DEFAULT_LANGUAGE=tr             # tr | en
VS_DEFAULT_CURRENCY=TRY
VS_TIMEZONE=Europe/Istanbul

# --- Security -------------------------------------------------------------
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(64))"
# Left as-is (or empty) the application generates an ephemeral key at start-up:
# fine for development, but every restart invalidates all sessions.
VS_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING

# First-run administrator password.  Leave EMPTY and a strong random password
# is generated on first start and printed to the console exactly once.
# Either way the account is locked down until that password is changed:
#   * every screen and endpoint outside the password-change flow answers 403;
#   * sign-in is refused from anything but the local device.
# There is no default password. `admin`/`admin` does not work.
VS_ADMIN_PASSWORD=

VS_ACCESS_TOKEN_MINUTES=120
VS_REFRESH_TOKEN_DAYS=14
VS_PASSWORD_MIN_LENGTH=8
VS_MAX_LOGIN_ATTEMPTS=5
VS_LOCKOUT_MINUTES=15
VS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database -------------------------------------------------------------
# SQLite (default, zero install):
VS_DATABASE_URL=sqlite:///./data/van_sales.db
# PostgreSQL (optional, recommended for >1M rows):
# VS_DATABASE_URL=postgresql+psycopg://vansales:YOUR_DB_PASSWORD@localhost:5432/van_sales
VS_DB_ECHO=false
VS_DB_POOL_SIZE=10

# --- Cache / Queue (optional; falls back to in-process memory) -------------
VS_REDIS_URL=
# VS_REDIS_URL=redis://localhost:6379/0

# --- AI: LM Studio (local, OpenAI-compatible) ------------------------------
VS_LMSTUDIO_ENABLED=true
VS_LMSTUDIO_BASE_URL=http://localhost:1234/v1
VS_LMSTUDIO_MODEL=google/gemma-4-12b-qat
VS_LMSTUDIO_TIMEOUT=180
VS_LMSTUDIO_MAX_TOKENS=2048
VS_LMSTUDIO_TEMPERATURE=0.3

# --- AI: NVIDIA (cloud, OpenAI-compatible) ---------------------------------
# Supply your own key here, or via the environment / your secret manager, or in
# the app under Settings -> AI Providers.  Empty => NOT_CONFIGURED, no calls.
VS_NVIDIA_ENABLED=true
VS_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VS_NVIDIA_API_KEY=
VS_NVIDIA_MODEL=meta/llama-3.3-70b-instruct
VS_NVIDIA_TIMEOUT=120
VS_NVIDIA_MAX_TOKENS=2048

# --- AI: Anthropic Claude (cloud) ------------------------------------------
# As above: your own key, or leave empty for NOT_CONFIGURED.
VS_CLAUDE_ENABLED=false
VS_CLAUDE_BASE_URL=https://api.anthropic.com/v1
VS_CLAUDE_API_KEY=
VS_CLAUDE_MODEL=claude-sonnet-5
VS_CLAUDE_TIMEOUT=120
VS_CLAUDE_MAX_TOKENS=4096

# --- AI: Router / Budget ---------------------------------------------------
VS_AI_FAILOVER_ORDER=lmstudio,nvidia,claude
VS_AI_MONTHLY_BUDGET_USD=25.00
VS_AI_BUDGET_WARN_PCT=80

# --- Backup ---------------------------------------------------------------
VS_BACKUP_DIR=./backups
VS_BACKUP_RETENTION_DAYS=30
VS_BACKUP_AUTO_ENABLED=true
VS_BACKUP_AUTO_CRON=daily          # daily | weekly | monthly | off

# --- Logging --------------------------------------------------------------
VS_LOG_DIR=./logs
VS_LOG_LEVEL=INFO
VS_LOG_MAX_BYTES=10485760
VS_LOG_BACKUP_COUNT=10

# ===========================================================================
#  Placeholder reference
# ---------------------------------------------------------------------------
#  Where an example value is genuinely needed, the literal string below is the
#  only one used anywhere in this project.  It is deliberately not shaped like
#  a real token, so secret scanners do not have to guess:
#
#      YOUR_PROVIDER_API_KEY_HERE
#
#  If a value in your working `.env` still reads like that, the provider is
#  not configured — that is a valid state, not an error.
# ===========================================================================
